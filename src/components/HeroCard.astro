---
// Reference M11: inset rounded image card that opens to full bleed on scroll (motion/expand.ts).
import { Image } from "astro:assets";
import { upload } from "@/lib/media";
interface Props { image: string; alt: string; overlay?: string; ratio?: string; position?: string; eager?: boolean }
const { image, alt, overlay, ratio = "1920 / 849", position = "50% 50%", eager = true } = Astro.props;
---
<figure class="hero-card" data-expand style={`--ratio:${ratio}`}>
  <div class="hero-card__media" data-expand-media>
    <Image src={upload(image)} alt={alt} widths={[640, 960, 1440, 1920]} sizes="100vw" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} style={`object-position:${position}`} />
  </div>
  {overlay && <figcaption class="hero-card__overlay" data-expand-overlay><span>{overlay}</span></figcaption>}
</figure>

<style>
  .hero-card {
    --inset: clamp(16px, 2.8vw, 40px);
    position: relative; margin: 0; overflow: hidden; aspect-ratio: var(--ratio); max-height: 100svh; width: 100%;
    clip-path: inset(0 var(--inset) round 15px);
  }
  :global(.js) .hero-card { will-change: clip-path; }
  .hero-card__media, .hero-card__media :global(img) { width: 100%; height: 100%; }
  .hero-card__media :global(img) { object-fit: cover; }
  .hero-card__overlay {
    position: absolute; inset: 0; display: grid; place-items: center; padding: var(--pad);
    background: linear-gradient(rgba(59, 22, 15, 0.12), rgba(59, 22, 15, 0.42));
    color: var(--cream); text-align: center;
    font-family: var(--font-serif); font-variation-settings: "opsz" 144; font-weight: 400; letter-spacing: 0.012em;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 5rem); line-height: 1; text-transform: uppercase; text-wrap: balance;
  }
  .hero-card__overlay span { max-width: 14ch; }
  @media (prefers-reduced-motion: reduce) { .hero-card { clip-path: none; } }
</style>
