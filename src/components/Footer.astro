---
import Logo from "@/assets/brand/eastern-logo.svg";
import { footerColumns } from "@/content/navigation";
import { siteConfig } from "@/content/site-config";
const year = new Date().getFullYear();
---
<footer class="footer on-dark" data-footer>
  <div class="footer__inner wrap" data-footer-inner>
    <p class="footer__wordmark" aria-hidden="true">
      <span class="footer__w1">Eastern</span>
      <span class="footer__w2">Condiments</span>
    </p>
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo class="footer__logo" aria-hidden="true" focusable="false" />
        <p class="footer__small">© {year} Eastern.<br />{siteConfig.ownership}</p>
      </div>
      {footerColumns.map((col) => (
        <nav class="footer__col" aria-label={col.label}>
          <p class="footer__label">{col.label}</p>
          <ul class:list={["footer__links", { "footer__links--two": col.links.length > 9 }]}>
            {col.links.map((l) => (
              <li><a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener" } : {})}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}</a></li>
            ))}
          </ul>
        </nav>
      ))}
      <div class="footer__col footer__offices">
        {siteConfig.offices.map((o) => (
          <div>
            <p class="footer__label">{o.label}</p>
            <address>{o.name}<br />{o.lines.map((l) => <>{l}<br /></>)}</address>
            <p><a href={`mailto:${o.email}`} class="footer__mail">{o.email}</a></p>
          </div>
        ))}
        <div>
          <p class="footer__label">Follow us</p>
          <ul class="footer__links">{siteConfig.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
        </div>
      </div>
    </div>
    <p class="footer__base"><a href="/privacy/">Privacy Policy</a><span>Toll free <a href="tel:18004255122">1800 425 5122</a></span></p>
  </div>
</footer>

<style>
  .footer { background: var(--clove); color: var(--cream); position: relative; z-index: 0; overflow: hidden; }
  .footer__inner { padding-top: clamp(3rem, 6vw, 5rem); padding-bottom: var(--pad); }
  .footer__wordmark {
    font-family: var(--font-serif); font-variation-settings: "opsz" 144; font-weight: 400; letter-spacing: 0.012em;
    color: var(--orange); line-height: 0.86; text-transform: uppercase;
    font-size: clamp(4.2rem, 16.4vw, 22rem); margin-left: clamp(0px, 12vw, 14rem);
  }
  .footer__w1, .footer__w2 { display: block; }
  .footer__w2 { font-style: italic; text-transform: none; font-size: 0.82em; letter-spacing: 0; }
  /* The only italic on most pages: skip rendering it until it nears the viewport, so its font isn't fetched on load.
     One word, so always one line: the placeholder is that line's height (line-height 0.86), so layout (and the
     footer-lift ScrollTrigger) is identical rendered or not; the clip margin lets glyphs overhang the tight line box. */
  .footer__w2 { content-visibility: auto; contain-intrinsic-block-size: auto 0.86em; overflow-clip-margin: 0.5em; }
  .footer__grid { display: grid; grid-template-columns: 1.1fr repeat(4, 1fr) 1.4fr; gap: var(--gutter); margin-top: clamp(3rem, 7vw, 6rem); font-size: 0.8125rem; line-height: 1.45; }
  .footer__logo { width: 64px; height: auto; margin-bottom: 1.25rem; }
  .footer__label { font: 600 var(--text-label)/1.2 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--orange); margin-bottom: 0.9rem; }
  .footer__links { list-style: none; display: grid; gap: 0.3rem; }
  .footer__links a, .footer__base a { opacity: 0.86; }
  .footer__links a:hover, .footer__base a:hover, .footer__mail:hover { opacity: 1; color: var(--orange); }
  .footer__offices { display: grid; gap: 1.5rem; }
  .footer__offices address { font-style: normal; opacity: 0.86; }
  .footer__mail { color: var(--orange); }
  .footer__small { opacity: 0.7; }
  .footer__base { display: flex; justify-content: space-between; gap: 1rem; margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--cream) 18%, transparent); font-size: 0.75rem; }
  @media (max-width: 1100px) { .footer__grid { grid-template-columns: repeat(3, 1fr); row-gap: 2.5rem; } }
  @media (max-width: 600px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand, .footer__offices { grid-column: 1 / -1; }
    .footer__wordmark { margin-left: 0; }
  }
</style>
