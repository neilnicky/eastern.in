---
import Logo from "@/assets/brand/eastern-logo.svg";
const doubled = (word: string) => [...word].map((c) => `<span class="roll" aria-hidden="true"><span>${c}</span><span>${c}</span></span>`).join("");
---
<header class="header" data-header>
  <a class="header__quick" href="/products/">Products</a>
  <a class="header__logo" href="/" aria-label="Eastern — home">
    <Logo aria-hidden="true" focusable="false" />
  </a>
  <button class="header__menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
    <span class="header__menu-label" data-label-open><span class="sr-only">Menu</span><Fragment set:html={doubled("MENU")} /></span>
    <span class="header__menu-label" data-label-close hidden><span class="sr-only">Close menu</span><Fragment set:html={doubled("CLOSE")} /></span>
    <span class="header__dot" aria-hidden="true"></span>
  </button>
</header>

<style>
  .header {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: start;
    padding: var(--header-offset) var(--pad) 0;
    pointer-events: none;
  }
  .header > * { pointer-events: auto; }
  .header__logo { grid-column: 2; display: block; width: var(--logo-w); transition: transform 0.6s var(--ease-soft); }
  .header__logo :global(svg) { width: 100%; height: auto; }
  :global(html.is-scrolled) .header__logo { transform: scale(0.78); transform-origin: 50% 0; }
  .header__quick, .header__menu {
    align-self: start; display: inline-flex; align-items: center; gap: 0.5rem;
    height: 2.25rem; padding: 0 0.35rem 0 1rem; border-radius: 99px;
    border: 1px solid var(--clove); background: color-mix(in srgb, var(--cream) 82%, transparent);
    backdrop-filter: blur(6px);
    font: 600 0.75rem/1 var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase; color: var(--clove);
  }
  .header__quick { grid-column: 1; justify-self: start; padding-right: 1rem; }
  .header__menu { grid-column: 3; justify-self: end; }
  .header__dot { width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--orange); position: relative; transition: transform 0.4s var(--ease-soft); }
  .header__dot::after { content: ""; position: absolute; inset: 0; margin: auto; width: 5px; height: 5px; border-radius: 50%; background: var(--cream); }
  .header__menu:hover .header__dot { transform: scale(1.12); }
  .header__menu-label { display: inline-flex; }
  .header__menu-label[hidden] { display: none; }
  :global(.roll) { display: inline-block; height: 1em; line-height: 1; overflow: hidden; vertical-align: top; }
  :global(.roll > span) { display: block; transition: transform 0.45s var(--ease-soft); }
  .header__menu:hover :global(.roll > span), .header__menu:focus-visible :global(.roll > span) { transform: translateY(-100%); }
  .header__menu :global(.roll:nth-child(2) > span) { transition-delay: 0.02s; }
  .header__menu :global(.roll:nth-child(3) > span) { transition-delay: 0.04s; }
  .header__menu :global(.roll:nth-child(4) > span) { transition-delay: 0.06s; }
  .header__menu :global(.roll:nth-child(5) > span) { transition-delay: 0.08s; }
  :global(html.menu-open) .header__quick { opacity: 0; pointer-events: none; }
  :global(html.menu-open) .header__menu, :global(html.menu-open) .header__quick { border-color: var(--clove); background: transparent; }
  @media (max-width: 480px) { .header__quick { font-size: 0.6875rem; padding: 0 0.75rem; } }
</style>
