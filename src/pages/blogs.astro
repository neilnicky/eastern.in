---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import ArchiveList from "@/components/ArchiveList.astro";
import { blogPosts } from "@/content/archive";
const img = (p: (typeof blogPosts)[number]) => (p.blocks.find((b) => b.type === "img") as { src: string } | undefined)?.src ?? null;
---
<Base title="Blogs" description="Company Blogs — Eastern's Onam songs, the Alleppey boat race and more.">
  <PageHead title="Blogs" eyebrow="Company Blogs" small />
  <div class="list"><ArchiveList items={blogPosts.map((p) => ({ href: p.path, title: p.title, meta: p.date?.replace(/^\w+day,\s*/, ""), image: img(p) }))} /></div>
</Base>
<style>.list { padding-block: var(--space-s) var(--space-l); }</style>
