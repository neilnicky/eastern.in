---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import HeroCard from "@/components/HeroCard.astro";
import Lead from "@/components/Lead.astro";
import { milestones, historyIntro, historyStories } from "@/content/history";
import { upload } from "@/lib/media";
const first = historyStories.find((s) => s.slug === "the-beginning-of-the-road")!;
const firstText = first.blocks.find((b) => b.type === "p") as { text: string };
---
<Base title="Timeline" description="Eastern's history from 1983: the Adimali spice factory, blended spices, exports, rice products, the MTR–Orkla merger and the M.E. Meeran Innovation Center.">
  <PageHead title={historyIntro.subtitle} eyebrow={historyIntro.title} />
  <HeroCard image="wp-content/uploads/2016/09/Eastern-Trading-Company.jpg" alt="Eastern Trading Company (ETC), the beginning of Eastern" overlay={first.title} ratio="1753 / 934" />
  <Lead><p>{firstText.text}</p></Lead>

  <section class="flood" aria-labelledby="milestones-title">
    <div class="flood__head wrap">
      <p class="label flood__side flood__side--l" data-parallax="40">1983</p>
      <h2 id="milestones-title" class="display flood__title" data-reveal>Milestones</h2>
      <p class="label flood__side flood__side--r" data-parallax="-40">2024</p>
    </div>
    <ol class="stack wrap" data-stack>
      {milestones.map((m, i) => (
        <li class="stack__card" data-stack-card style={`--i:${i}`}>
          <article class="card">
            {m.image ? <Image class="card__img" src={upload(m.image)} alt="" widths={[360, 560]} sizes="(max-width: 700px) 80vw, 24vw" /> : <span class="card__img card__img--year" aria-hidden="true">{m.year.slice(2)}</span>}
            <div class="card__body">
              <p class="card__year">{m.year}.</p>
              <div class="card__lines">{m.lines.map((l) => <p>{l}</p>)}</div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="section archive wrap" aria-labelledby="archive-title">
    <h2 id="archive-title" class="title" data-reveal>From the archive</h2>
    <ul class="archive__list">
      {historyStories.map((s) => (
        <li><a href={s.path}><span class="archive__title">{s.title}</span><span aria-hidden="true">→</span></a></li>
      ))}
    </ul>
    <figure class="infographic">
      <Image src={upload(historyIntro.infographic)} alt={`Eastern timeline infographic: ${milestones.map((m) => `${m.year} — ${m.lines.join("; ")}`).join(". ")}.`} widths={[700, 1100, 1400]} sizes="(max-width: 900px) 100vw, 900px" />
      <figcaption class="label">The timeline as published on eastern.in</figcaption>
    </figure>
  </section>
</Base>

<style>
  .flood { background: var(--turmeric); color: var(--clove); border-radius: 22px; margin: var(--space-l) 8px 0; padding-block: var(--space-xl) var(--space-l); }
  .flood__head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-bottom: var(--space-l); }
  .flood__title { color: var(--clove); text-align: center; }
  .flood__side { color: var(--clove); font-size: 0.8125rem; }
  .flood__side--r { text-align: right; }
  .stack { list-style: none; display: grid; gap: 4vh; }
  .stack__card { position: sticky; top: calc(14vh + var(--i) * 6px); }
  .card { display: grid; grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr); gap: clamp(1rem, 2.5vw, 2.5rem); max-width: 980px; margin: 0 auto; padding: clamp(0.75rem, 1.2vw, 1rem); background: #fff; border-radius: 12px; min-height: clamp(240px, 34vh, 360px); transform-origin: 50% 0; box-shadow: 0 18px 40px rgba(59, 22, 15, 0.08); }
  .card__img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
  .card__img--year { display: grid; place-items: center; background: var(--cream); color: var(--orange-ink); font-family: var(--font-serif); font-variation-settings: "opsz" 144; font-size: clamp(4rem, 9vw, 9rem); line-height: 1; }
  .card__body { display: grid; align-content: space-between; gap: 1.5rem; padding: 0.5rem 0.5rem 0.5rem 0; }
  .card__year { font-family: var(--font-serif); font-variation-settings: "opsz" 144; font-size: clamp(3rem, 2rem + 4vw, 6rem); line-height: 0.9; color: var(--orange-ink); }
  .card__lines { display: grid; gap: 0.75rem; font-family: var(--font-serif); font-variation-settings: "opsz" 24; font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.5rem); line-height: 1.25; text-transform: uppercase; letter-spacing: 0.01em; }
  .archive .title { margin-bottom: var(--space-s); }
  .archive__list { list-style: none; max-width: 60rem; margin: 0 auto; border-top: 1px solid var(--clove); columns: 2 22rem; column-gap: var(--gutter); }
  .archive__list li { break-inside: avoid; border-bottom: 1px solid var(--rule); }
  .archive__list a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; }
  .archive__list a:hover { color: var(--orange-text); }
  .infographic { max-width: 900px; margin: var(--space-l) auto 0; display: grid; gap: 0.75rem; justify-items: center; }
  @media (max-width: 700px) {
    .card { grid-template-columns: 1fr; }
    .card__img { aspect-ratio: 16 / 10; }
    .flood__head { grid-template-columns: 1fr; text-align: center; }
    .flood__side { display: none; }
  }
</style>
