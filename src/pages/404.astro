---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
---
<Base title="Page not found" noindex>
  <PageHead title="Page not found" small>
    <p class="msg">The page you are looking for is not here. It may have moved when the site was rebuilt.</p>
    <p class="links"><a class="pill-link" href="/products/">Products</a> <a class="pill-link" href="/recipes/">Recipes</a> <a class="pill-link" href="/">Home</a></p>
  </PageHead>
  <div class="spacer"></div>
</Base>
<style>
  .msg { margin-top: 1.5rem; font-size: var(--text-medium); }
  .links { margin-top: 2rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .spacer { height: 20vh; }
</style>
