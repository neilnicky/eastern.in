---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import ArchiveList from "@/components/ArchiveList.astro";
import { events } from "@/content/archive";
const img = (e: (typeof events)[number]) => (e.blocks.find((b) => b.type === "img") as { src: string } | undefined)?.src ?? null;
---
<Base title="Events" description={`Eastern events and initiatives — ${events.length} events from Bhoomika to product launches.`}>
  <PageHead title="Events" small />
  <div class="list"><ArchiveList items={events.map((e) => ({ href: e.path, title: e.title, meta: [e.eventDate, e.location].filter(Boolean).join(" · "), image: img(e) }))} /></div>
</Base>
<style>.list { padding-block: var(--space-s) var(--space-l); }</style>
